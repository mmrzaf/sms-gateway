# Local configuration for docker compose. Copy to deploy/.env (make up does
# this automatically). Every variable is documented in
# docs/090-operations/020-configuration.md.

DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway?sslmode=disable
LOG_LEVEL=info

# Dashboard and admin API password (user "admin"). Local use only.
ADMIN_TOKEN=admin

# Providers in priority order, and the shared secret for delivery reports.
# The provider services read PROVIDER_SECRET from this file as well.
PROVIDERS=A=http://provider-a:9001,B=http://provider-b:9002
PROVIDER_SECRET=local-provider-secret
